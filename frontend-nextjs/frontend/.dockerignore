# 依赖目录（会在容器内重新安装）
node_modules/
.npm
.pnpm

# 开发环境构建缓存
.next/cache/

# 环境变量文件（生产环境使用不同的配置）
.env.local
.env.development
.env.test

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 覆盖文件
*.tgz
*.tar.gz

# IDE 文件
.vscode/
.idea/
*.swp
*.swo

# OS 文件
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# 测试文件
coverage/
.jest/

# 文档
README.md

# TypeScript 构建信息
*.tsbuildinfo

# ESLint 缓存
.eslintcache